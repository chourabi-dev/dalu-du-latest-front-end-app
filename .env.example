# Base URL of the ordering backend (restaurants, menu, extras, auth, orders)
VITE_API_BASE_URL=http://localhost:8000

# Google OAuth Client ID, used for "Sign in with Google" on checkout.
# Create one at https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=

# PayPal REST app Client ID, used for the "Pay online" checkout option.
# Create one at https://developer.paypal.com/dashboard/applications — use a
# sandbox app while developing, a live app in production. Currency is EUR.
VITE_PAYPAL_CLIENT_ID=
